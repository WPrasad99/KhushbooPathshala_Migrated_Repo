    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'group_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'user_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'role' => ['type' => 'varchar', 'length' => 32, 'default' => 'MEMBER', 'not null' => TRUE],
