    ],
    'primary key' => ['id'],
  ];

  $schema['kp_quiz_submissions'] = [
    'description' => 'Student quiz attempts and scores.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'quiz_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'student_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'score' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'total_score' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'passed' => ['type' => 'int', 'size' => 'tiny', 'default' => 0, 'not null' => TRUE],
      'answers' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'submitted_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
  ];

  $schema['kp_forum_posts'] = [
    'description' => 'Q&A discussion forum posts.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'user_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'batch_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'title' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'content' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'tags' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'upvotes' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
  ];

  $schema['kp_forum_answers'] = [
    'description' => 'Answers to forum posts.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
