      'user_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'content' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'upvotes' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'is_accepted' => ['type' => 'int', 'size' => 'tiny', 'default' => 0, 'not null' => TRUE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'post_idx' => ['post_id'],
    ],
  ];

  $schema['kp_announcements'] = [
    'description' => 'Platform announcements.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
