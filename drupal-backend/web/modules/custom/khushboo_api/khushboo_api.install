<?php

/**
 * @file
 * Install and schema hooks for Khushboo Pathshala API.
 */

/**
 * Implements hook_schema().
 */
function khushboo_api_schema() {
  $schema = [];

  $schema['kp_users'] = [
    'description' => 'Khushboo Pathshala platform users.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'email' => ['type' => 'varchar', 'length' => 191, 'not null' => TRUE],
      'password_hash' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'role' => ['type' => 'varchar', 'length' => 32, 'default' => 'STUDENT', 'not null' => TRUE],
      'phone' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'gender' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'date_of_birth' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'education_level' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'avatar' => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'bio' => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'hobbies' => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'skills' => ['type' => 'text', 'size' => 'medium', 'not null' => FALSE],
      'profile_completed' => ['type' => 'int', 'size' => 'tiny', 'default' => 0, 'not null' => TRUE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['email' => ['email']],
    'indexes' => ['role' => ['role']],
  ];

  $schema['kp_batches'] = [
    'description' => 'Student and mentor batches.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'description' => ['type' => 'text', 'not null' => FALSE],
      'code' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'start_date' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'end_date' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
  ];

  $schema['kp_batch_students'] = [
    'description' => 'Students enrolled in batches.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'batch_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'user_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'joined_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'batch_user' => ['batch_id', 'user_id'],
      'user_idx' => ['user_id'],
    ],
  ];

  $schema['kp_batch_mentors'] = [
    'description' => 'Mentors assigned to batches.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'batch_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'user_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'assigned_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'batch_mentor' => ['batch_id', 'user_id'],
      'mentor_idx' => ['user_id'],
    ],
  ];

  $schema['kp_resources'] = [
    'description' => 'Learning courses, sessions, and materials.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'title' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'description' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'category' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'video_url' => ['type' => 'text', 'not null' => FALSE],
      'duration' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'thumbnail_url' => ['type' => 'text', 'not null' => FALSE],
      'lessons_count' => ['type' => 'int', 'default' => 1, 'not null' => TRUE],
      'lessons' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'is_hot' => ['type' => 'int', 'size' => 'tiny', 'default' => 0, 'not null' => TRUE],
      'type' => ['type' => 'varchar', 'length' => 32, 'default' => 'COURSE', 'not null' => TRUE],
      'batch_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'uploaded_by_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'not null' => TRUE],
      'deleted_at' => ['type' => 'int', 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'category_idx' => ['category'],
      'batch_idx' => ['batch_id'],
      'type_idx' => ['type'],
    ],
  ];

  $schema['kp_session_tracking'] = [
    'description' => 'Student video progress and auto attendance.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'user_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'resource_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'watch_duration' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'total_duration' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'drop_off_point' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'completion_percentage' => ['type' => 'int', 'default' => 0, 'not null' => TRUE],
      'attendance_marked' => ['type' => 'int', 'size' => 'tiny', 'default' => 0, 'not null' => TRUE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'user_resource' => ['user_id', 'resource_id'],
    ],
  ];

  $schema['kp_mentorship'] = [
    'description' => 'Mentor-mentee relations.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'mentor_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'mentee_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'assigned_at' => ['type' => 'int', 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 32, 'default' => 'ACTIVE', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
  ];

  $schema['kp_meetings'] = [
    'description' => 'Scheduled mentorship meetings.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'mentor_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'mentee_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'batch_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'title' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'description' => ['type' => 'text', 'not null' => FALSE],
      'meeting_link' => ['type' => 'text', 'not null' => FALSE],
      'scheduled_at' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 32, 'default' => 'SCHEDULED', 'not null' => TRUE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
  ];

  $schema['kp_assignments'] = [
    'description' => 'Batch assignments.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'title' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'description' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'batch_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'due_date' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'created_by_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'created_at' => ['type' => 'int', 'not null' => TRUE],
      'updated_at' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
  ];

  $schema['kp_assignment_submissions'] = [
    'description' => 'Student submissions for assignments.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'assignment_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'student_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'submission_url' => ['type' => 'text', 'not null' => FALSE],
      'file_path' => ['type' => 'text', 'not null' => FALSE],
      'notes' => ['type' => 'text', 'not null' => FALSE],
      'grade' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'feedback' => ['type' => 'text', 'not null' => FALSE],
      'status' => ['type' => 'varchar', 'length' => 32, 'default' => 'SUBMITTED', 'not null' => TRUE],
      'submitted_at' => ['type' => 'int', 'not null' => TRUE],
      'reviewed_at' => ['type' => 'int', 'not null' => FALSE],
      'reviewed_by_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'sub_assign_student' => ['assignment_id', 'student_id'],
    ],
  ];

  $schema['kp_quizzes'] = [
    'description' => 'Quizzes and assessments.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'title' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'description' => ['type' => 'text', 'not null' => FALSE],
      'batch_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'created_by_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'duration_minutes' => ['type' => 'int', 'default' => 30, 'not null' => TRUE],
